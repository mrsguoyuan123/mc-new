	} from '@/api/frontApikit.js'
	const scaleWeights = [
		70.5, 70.3, 70.2, 70.3, 70.0, 69.9, 70.0, 69.8,
		68.9, 68.7, 68.8, 68.6, 68.7, 68.5, 68.6, 68.4,
		68.5, 68.6, 68.4, 68.5, 68.3, 68.4, 68.5, 68.7,
		68.6, 68.8, 68.4, 68.7, 68.6, 68.4
	]

	function padNumber(value) {
		return value < 10 ? '0' + value : '' + value
	}

	function buildInitialRecords() {
		const end = new Date()
		end.setMinutes(Math.max(0, end.getMinutes() - 8), 0, 0)
		const records = []

		for (let i = 29; i >= 0; i--) {
			const date = new Date(end.getTime() - i * 24 * 60 * 60 * 1000)
			records.push({
				weight: scaleWeights[29 - i],
				time: date.getFullYear() +
					'-' +
					padNumber(date.getMonth() + 1) +
					'-' +
					padNumber(date.getDate()) +
					' ' + padNumber(date.getHours()) + ':' + padNumber(date.getMinutes()),
				source: 'scale'
			})
		}

		return records
	}

	export default {
		data() {
			const now = new Date()
			const records = buildInitialRecords()
			return {
				activeRange: '7d',
				rangeOptions: [{
						label: '7天',
						value: '7d'
					},
					{
						label: '30天',
						value: '30d'
					}
				],
                weightRecords:[],
				bluetoothStatus: 'connected',
				searchTimer: null,
				showWeightPopup: false,
				inputWeight: '',
				inputDate: this.formatDate(now, 'YYYY-MM-DD'),
				inputTime: this.formatDate(now, 'HH:mm'),
				inputSource: 'manual',
				lastSyncTime: records[records.length - 1].time,
				weightRecords: records
			}
		},
		computed: {
			sortedRecords() {
    return this.weightRecords.slice().sort((a, b) => {
      const timeA = a.recordDate ? new Date(a.recordDate.replace(/-/g, '/')).getTime() : 0
      const timeB = b.recordDate ? new Date(b.recordDate.replace(/-/g, '/')).getTime() : 0
      return timeB - timeA
    })
  },
			latestRecord() {
				return this.sortedRecords[this.sortedRecords.length - 1] || null
			},
			todayDate() {
				return this.formatDate(new Date(), 'YYYY-MM-DD')
			},
			filteredRecords() {
				if (!this.latestRecord) return []
				const end = new Date(this.latestRecord.recordDate.replace(/-/g, '/')).getTime()
				const start = end - (this.activeRange - 1) * 24 * 60 * 60 * 1000
				return this.sortedRecords.filter(item => {
					const time = new Date(item.recordDate.replace(/-/g, '/')).getTime()
					return time >= start && time <= end
				})
			},
			weightChartData() {
				const records = this.filteredRecords
				return {
					categories: records.map(item => this.formatDate(item.time, 'MM/DD')),
					series: [{
						name: '体重',
						data: records.map(item => Number(item.weightKg.toFixed(1)))
					}]
				}
			},
			chartAxis() {
				const values = this.filteredRecords.map(item => item.weight)
				if (!values.length) return {
					min: 0,
					max: 100,
					step: 20
				}
				const minValue = Math.min.apply(null, values)
				const maxValue = Math.max.apply(null, values)
				if (this.activeRange === 7 && minValue >= 68.4 && maxValue <= 68.8) {
					return {
						min: 68.4,
						max: 68.8,
						step: 0.2
					}
				}
				if (minValue >= 68 && maxValue <= 70.5) {
					return {
						min: 68,
						max: 71,
						step: 1
					}
				}
				const rawSpan = Math.max(maxValue - minValue, 1)
				const span = Math.max(rawSpan * 1.25, 1.5)
				const magnitude = Math.pow(10, Math.floor(Math.log(span / 4) / Math.LN10))
				const residual = span / 4 / magnitude
				let niceStep = magnitude
				if (residual > 5) niceStep = 10 * magnitude
				else if (residual > 2) niceStep = 5 * magnitude
				else if (residual > 1) niceStep = 2 * magnitude
				return {
					min: Math.floor((minValue - (span - rawSpan) / 2) / niceStep) * niceStep,
					max: Math.ceil((maxValue + (span - rawSpan) / 2) / niceStep) * niceStep,
					step: niceStep
				}
			},
			weightChartOpts() {
				const axis = this.chartAxis
				return {
					color: ['#165cf5'],
					padding: [12, 18, 0, 0],
					enableScroll: false,
					legend: {
						show: false
					},
					dataLabel: false,
					dataPointShape: true,
					xAxis: {
						disableGrid: true,
						axisLine: false,
						fontSize: 12,
						fontColor: '#8f98a8',
						lineHeight: 24,
						boundaryGap: 'justify',
						labelCount: this.activeRange === 30 ? 5 : undefined
					},
					yAxis: {
						data: [{
							min: axis.min,
							max: axis.max,
							fontSize: 11,
							fontColor: '#98a2b3',
							tofix: 1,
							unit: 'kg'
						}],
						disabled: false,
						disableGrid: false,
						gridType: 'dash',
						dashLength: 4,
						gridColor: '#edf0f5',
						splitNumber: 2,
						min: axis.min,
						max: axis.max,
						fontSize: 11,
						fontColor: '#98a2b3',
						tofix: 1,
						unit: 'kg'
					},
					extra: {
						area: {
							type: 'curve',
							width: 3,
							addLine: true,
							gradient: true,
							opacity: 0.14,
							activeType: 'none'
						},
						tooltip: {
							showCategory: true
						}
					}
				}
			},
			changeFromLast() {
				const records = this.sortedRecords
				if (records.length < 2) return {
					value: 0,
					direction: 'flat',
					arrow: ''
				}
				return this.buildChange(records[records.length - 1].weightKg - records[records.length - 2].weightKg)
			},
			changeFromThirty() {
				if (this.sortedRecords.length < 2) return {
					value: 0,
					direction: 'flat',
					arrow: ''
				}
				const latest = this.sortedRecords[this.sortedRecords.length - 1].weight
				return this.buildChange(latest - this.sortedRecords[0].weight)
			}
		},
		beforeDestroy() {
