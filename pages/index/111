				})
			},
			disconnectDevice() {
				this.clearSearchTimer()
				this.bluetoothStatus = 'searching'
				this.searchTimer = setTimeout(() => {
					this.bluetoothStatus = 'connected'
					this.searchTimer = null
					uni.showToast({
						title: '已重新连接智能体脂秤S1',
						icon: 'none'
					})
				}, 1800)
				uni.showToast({
					title: '正在重新搜索体脂秤',
					icon: 'none'
				})
			},
			syncWeight() {
				if (this.bluetoothStatus !== 'connected') return
				const now = new Date()
				const records = this.sortedRecords
				const latest = records[records.length - 1]
				this.lastSyncTime = this.formatDate(now, 'YYYY-MM-DD HH:mm')
				if (latest) {
					latest.source = 'scale'
					latest.time = this.formatDate(now, 'YYYY-MM-DD HH:mm')
					this.weightRecords = records
				}
				uni.showToast({
					title: '体重数据已同步',
					icon: 'success'
				})
			},
			isValidDate(date) {
				return date instanceof Date && !Number.isNaN(date.getTime())
			},
			sourceText(source) {
				return source === 'manual' ? '手动记录' : '体脂秤同步'
			},
			formatWeight(weight) {
				return Number(weight).toFixed(1)
			},
			formatChange(value) {
				const number = Math.abs(value)
				return (value < 0 ? '-' : value > 0 ? '+' : '') + (number < 0.05 ? '0.0' : number.toFixed(1))
			},
			showConnectHelp() {
				uni.showModal({
					title: '连接遇到问题？',
					content: '请确认手机蓝牙已开启，体脂秤电量充足，并靠近手机后重新搜索。',
					showCancel: false,
					confirmText: '知道了'
				})
			},
			clearSearchTimer() {
				if (this.searchTimer) {
					clearTimeout(this.searchTimer)
					this.searchTimer = null
				}
			},
			buildChange(value) {
				if (Math.abs(value) < 0.05) return {
					value: 0,
					direction: 'flat',
					arrow: '→'
				}
				return {
					value,
					direction: value < 0 ? 'down' : 'up',
					arrow: value < 0 ? '↘' : '↗'
				}
			},
			formatAbsChange(value) {
				const number = Math.abs(value)
				return (value < 0 ? '-' : value > 0 ? '+' : '') + (number < 0.05 ? '0.0' : number.toFixed(1))
			},
			formatDate(input, pattern) {
				const date = input instanceof Date ? input : new Date(String(input).replace(/-/g, '/'))
				const year = date.getFullYear()
				const month = date.getMonth() + 1
				const day = date.getDate()
				const hours = date.getHours()
				const minutes = date.getMinutes()
				const pad = number => String(number).padStart(2, '0')
				return pattern
					.replace('YYYY', year)
					.replace('MM', pad(month))
					.replace('DD', pad(day))
					.replace('HH', pad(hours))
					.replace('mm', pad(minutes))
			}
		}
