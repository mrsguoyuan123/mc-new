			},
			saveWeight() {
				const weight = Number(this.inputWeight)
				if (!weight || weight <= 20 || weight > 300) {
					uni.showToast({
						title: '请输入 20-300kg 的体重',
						icon: 'none'
					})
					return
				}
				const time = this.inputDate + ' ' + this.inputTime
				if (this.isValidDate(new Date(time.replace(/-/g, '/'))) === false) {
					uni.showToast({
						title: '请选择有效的记录时间',
						icon: 'none'
					})
					return
				}
				this.weightRecords = this.weightRecords
					.filter(item => item.time !== time)
					.concat({
						weight: Number(weightKg.toFixed(1)),
